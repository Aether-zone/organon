{
  /*
   * The config tsup generates declarations against.
   *
   * Separate from `tsconfig.lib.json`, which describes the typecheck and emits
   * declarations to `dist/libs/organon` for `nest build`. This one is the
   * bundler's, and has to leave `incremental`/`composite` alone.
   */
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "removeComments": false,
    "noEmit": false,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
